{
  "source": "Hand-constructed vectors from the definitions of Hamming weight/distance, minimum distance, and nearest-neighbor decoding. Includes the well-known Cryptopals Set 1 Challenge 6 byte-string example: d(b\"this is a test\", b\"wokka wokka!!!\") = 37.",
  "vectors": [
    {
      "op": "hamming_weight",
      "inputs": { "v": [1, 0, 1, 1, 0, 1] },
      "expected": 4
    },
    {
      "op": "hamming_distance",
      "inputs": { "a": [1, 0, 1, 1, 0, 1], "b": [1, 1, 0, 1, 0, 0] },
      "expected": 3
    },
    {
      "op": "hamming_distance_bytes",
      "inputs": { "a_hex": "7468697320697320612074657374", "b_hex": "776f6b6b6120776f6b6b61212121" },
      "expected": 37
    },
    {
      "op": "normalized_hamming_distance_bytes",
      "inputs": { "a_hex": "7468697320697320612074657374", "b_hex": "776f6b6b6120776f6b6b61212121" },
      "expected": 2.642857142857143
    },
    {
      "op": "minimum_distance",
      "inputs": { "codewords": [[0, 0, 0], [1, 1, 1]] },
      "expected": 3
    },
    {
      "op": "max_detectable_errors",
      "inputs": { "d_min": 3 },
      "expected": 2
    },
    {
      "op": "max_correctable_errors",
      "inputs": { "d_min": 3 },
      "expected": 1
    },
    {
      "op": "nearest_neighbor_decode",
      "inputs": { "received": [0, 1, 0], "codewords": [[0, 0, 0], [1, 1, 1]] },
      "expected": { "decoded": [0, 0, 0], "distance": 1 }
    },
    {
      "op": "minimum_distance",
      "inputs": { "codewords": [[0, 0], [1, 1]] },
      "expected": 2
    }
  ]
}
