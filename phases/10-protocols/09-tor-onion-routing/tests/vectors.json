{
  "source": "Tor onion routing is specified in the Tor Protocol Specification (tor-spec.txt) and related design papers. This lesson uses a toy onion packet format and a toy AEAD (XOR stream + HMAC tag) for educational purposes only. Expected values were computed from this repository's reference implementation (phases/10-protocols/09-tor-onion-routing/code/main.py) to lock behavior.",
  "vectors": [
    {
      "op": "sha256_hex",
      "inputs": { "data_hex": "616263" },
      "expected_hex": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    },
    {
      "op": "prg_stream_hex",
      "inputs": {
        "key_hex": "c48a01f49fd0f2cc404bc3cbbc80e91457a3d41bb429a695243de4c61794155c",
        "nonce_hex": "00000000000000000000000000000000",
        "length": 32
      },
      "expected_hex": "be844b29fbe9c395490dee92e6d994c902b5e1e71c76479061bab8fd2d357c4e"
    },
    {
      "op": "seal_hex",
      "inputs": {
        "key_hex": "c48a01f49fd0f2cc404bc3cbbc80e91457a3d41bb429a695243de4c61794155c",
        "nonce_hex": "00000000000000000000000000000000",
        "plaintext_hex": "68656c6c6f206f6e696f6e",
        "aad_hex": "686561646572"
      },
      "expected_hex": "00000000000000000000000000000000076ef9d41c567c3876401b7d880361bfd6e1274594c9acfb206280"
    },
    {
      "op": "open_sealed_hex",
      "inputs": {
        "key_hex": "c48a01f49fd0f2cc404bc3cbbc80e91457a3d41bb429a695243de4c61794155c",
        "aad_hex": "686561646572",
        "sealed_hex": "00000000000000000000000000000000076ef9d41c567c3876401b7d880361bfd6e1274594c9acfb206280"
      },
      "expected_hex": "68656c6c6f206f6e696f6e"
    },
    {
      "op": "encode_exit_payload_utf8",
      "inputs": {
        "dest": "example.com:80",
        "message_hex": "474554202f20485454502f312e300d0a0d0a"
      },
      "expected_utf8": "{\"dest\":\"example.com:80\",\"kind\":\"exit\",\"message_hex\":\"474554202f20485454502f312e300d0a0d0a\"}"
    },
    {
      "op": "encode_relay_payload_utf8",
      "inputs": { "next_hop": "middle", "inner_hex": "010203" },
      "expected_utf8": "{\"inner_hex\":\"010203\",\"kind\":\"relay\",\"next_hop\":\"middle\"}"
    },
    {
      "op": "build_onion_packet_hex",
      "inputs": {
        "route": [
          {
            "name": "guard",
            "key_hex": "5e5d5f8a4499e3d8302305f5ce268f42da3af132175625f3a4805b53453f8cca"
          },
          {
            "name": "middle",
            "key_hex": "954412d6f5805ed0e098ff12da89852f6cd689b588d03613931d4d8dafdf53a1"
          },
          {
            "name": "exit",
            "key_hex": "07a1acf4b8773a1ed39c1837a786a1ac481052890eb584d3f53abd40f1398dad"
          }
        ],
        "dest": "example.com:80",
        "message_hex": "474554202f20485454502f312e300d0a0d0a",
        "packet_seed_hex": "8804d889030664f953f6ab21c948dad82b07ae4efc93ea3ea02f6d12d271abeb"
      },
      "expected_hex": ""
    },
    {
      "op": "peel_one_layer",
      "inputs": {
        "hop": {
          "name": "guard",
          "key_hex": "5e5d5f8a4499e3d8302305f5ce268f42da3af132175625f3a4805b53453f8cca"
        },
        "onion_packet_hex": ""
      },
      "expected": {
        "next_hop": "middle",
        "inner_hex": ""
      }
    }
  ]
}
