    {"op": "units_mod", "n": 8, "expected": [1, 3, 5, 7]},
    {"op": "units_mod", "n": 10, "expected": [1, 3, 7, 9]},
    {"op": "add_mod", "a": 4, "b": 3, "n": 5, "expected": 2},
    {"op": "mul_mod", "a": 7, "b": 9, "n": 10, "expected": 3},
    {
      "op": "cayley_table_add_mod",
      "n": 4,
      "expected": [
        [0, 1, 2, 3],
        [1, 2, 3, 0],
        [2, 3, 0, 1],
        [3, 0, 1, 2]
      ]
    },
    {"op": "find_identity_add_mod", "n": 6, "expected": 0},
    {"op": "inverse_of_add_mod", "element": 4, "n": 7, "expected": 3},
    {"op": "element_order_add_mod", "element": 2, "n": 6, "expected": 3},
    {"op": "element_order_add_mod", "element": 5, "n": 6, "expected": 6},
    {"op": "find_identity_units_mod", "n": 8, "expected": 1},
    {"op": "inverse_of_units_mod", "element": 3, "n": 10, "expected": 7},
    {"op": "element_order_units_mod", "element": 3, "n": 10, "expected": 4},
    {
      "op": "group_report_add_mod",
      "n": 5,
      "expected": {
        "order": 5,
        "closed": true,
        "associative": true,
        "identity": 0,
        "inverses": {"0": 0, "1": 4, "2": 3, "3": 2, "4": 1},
