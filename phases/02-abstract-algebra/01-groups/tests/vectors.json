        "is_group": true
      }
    },
    {
      "op": "group_report_units_mod",
      "n": 8,
      "expected": {
        "order": 4,
        "closed": true,
        "associative": true,
        "identity": 1,
        "inverses": {"1": 1, "3": 3, "5": 5, "7": 7},
        "element_orders": {"1": 1, "3": 2, "5": 2, "7": 2},
        "is_group": true
      }
    },
    {"op": "is_group_add_mod", "n": 1, "expected": true},
    {"op": "is_group_raw_multiplication", "elements": [0, 1, 2, 3], "expected": false},
    {"op": "residues_mod", "n": 0, "expected_error": "modulus must be positive"}
