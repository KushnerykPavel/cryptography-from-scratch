{
  "source": "Project-internal NTT vectors over F_17. omega=9 is a primitive 8th root of unity and psi=3 is a primitive 16th root (since 3 is a primitive root mod 17 and 3^2=9). Vectors are cross-checked against the slow DFT definition of the NTT and against naive cyclic/negacyclic polynomial multiplication.",
  "vectors": [
    {
      "op": "find_primitive_nth_root",
      "n": 8,
      "p": 17,
      "expected": 9
    },
    {
      "op": "ntt_slow",
      "a": [0, 1, 2, 3, 4, 5, 6, 7],
      "p": 17,
      "omega": 9,
      "expected": [11, 1, 12, 3, 13, 6, 14, 8]
    },
    {
      "op": "ntt",
      "a": [0, 1, 2, 3, 4, 5, 6, 7],
      "p": 17,
      "omega": 9,
      "expected": [11, 1, 12, 3, 13, 6, 14, 8]
    },
    {
      "op": "intt_roundtrip",
      "a": [0, 1, 2, 3, 4, 5, 6, 7],
      "p": 17,
      "omega": 9,
      "expected": [0, 1, 2, 3, 4, 5, 6, 7]
    },
    {
      "op": "cyclic_convolution",
      "a": [0, 1, 2, 3, 4, 5, 6, 7],
      "b": [1, 0, 2, 0, 3, 0, 4, 0],
      "p": 17,
      "omega": 9,
      "expected": [15, 8, 2, 12, 15, 8, 3, 13]
    },
    {
      "op": "negacyclic_convolution",
      "a": [0, 1, 2, 3, 4, 5, 6, 7],
      "b": [1, 0, 2, 0, 3, 0, 4, 0],
      "p": 17,
      "psi": 3,
      "expected": [2, 11, 2, 15, 1, 3, 3, 13]
    },
    {
      "op": "ntt",
      "a": [1, 2, 3, 4, 5, 6],
      "p": 17,
      "omega": 9,
      "expected_error": "n must be a power of two"
    },
    {
      "op": "ntt",
      "a": [0, 1, 2, 3, 4, 5, 6, 7],
      "p": 17,
      "omega": 4,
      "expected_error": "omega is not a primitive n-th root of unity"
    }
  ]
}
