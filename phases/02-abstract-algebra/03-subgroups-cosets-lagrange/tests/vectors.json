{
  "source": "Project-internal finite group examples cross-checked by direct modular arithmetic over Z/nZ and (Z/nZ)^*. Lagrange examples follow the standard finite-group theorem that subgroup order divides group order.",
  "vectors": [
    {
      "op": "generated_subgroup_add_mod",
      "element": 3,
      "n": 12,
      "expected": [0, 3, 6, 9]
    },
    {
      "op": "generated_subgroup_add_mod",
      "element": 4,
      "n": 12,
      "expected": [0, 4, 8]
    },
    {
      "op": "generated_subgroup_units_mod",
      "element": 3,
      "n": 8,
      "expected": [1, 3]
    },
    {
      "op": "is_subgroup_add_mod",
      "subset": [0, 3, 6, 9],
      "n": 12,
      "expected": true
    },
    {
      "op": "is_subgroup_add_mod",
      "subset": [0, 2, 3],
      "n": 12,
      "expected": false
    },
    {
      "op": "is_subgroup_units_mod",
      "subset": [1, 3],
      "n": 8,
      "expected": true
    },
    {
      "op": "left_coset_add_mod",
      "representative": 1,
      "subgroup": [0, 3, 6, 9],
      "n": 12,
      "expected": [1, 4, 7, 10]
    },
    {
      "op": "right_coset_add_mod",
      "representative": 2,
      "subgroup": [0, 3, 6, 9],
      "n": 12,
      "expected": [2, 5, 8, 11]
    },
    {
      "op": "left_cosets_add_mod",
      "subgroup": [0, 3, 6, 9],
      "n": 12,
      "expected": [[0, 3, 6, 9], [1, 4, 7, 10], [2, 5, 8, 11]]
    },
    {
      "op": "right_cosets_add_mod",
      "subgroup": [0, 3, 6, 9],
      "n": 12,
      "expected": [[0, 3, 6, 9], [1, 4, 7, 10], [2, 5, 8, 11]]
    },
    {
      "op": "left_coset_units_mod",
      "representative": 5,
      "subgroup": [1, 3],
      "n": 8,
      "expected": [5, 7]
    },
    {
      "op": "right_coset_units_mod",
      "representative": 5,
      "subgroup": [1, 3],
      "n": 8,
      "expected": [5, 7]
    },
    {
      "op": "left_cosets_units_mod",
      "subgroup": [1, 3],
      "n": 8,
      "expected": [[1, 3], [5, 7]]
    },
    {
      "op": "cosets_partition_group_add_mod",
      "subgroup": [0, 3, 6, 9],
      "n": 12,
      "expected": true
    },
    {
      "op": "subgroup_index_add_mod",
      "subgroup": [0, 3, 6, 9],
      "n": 12,
      "expected": 3
    },
    {
      "op": "subgroup_index_units_mod",
      "subgroup": [1, 3],
      "n": 8,
      "expected": 2
    },
    {
      "op": "lagrange_holds_add_mod",
      "subgroup": [0, 3, 6, 9],
      "n": 12,
      "expected": true
    },
    {
      "op": "lagrange_holds_units_mod",
      "subgroup": [1, 3],
      "n": 8,
      "expected": true
    },
    {
      "op": "lagrange_report_add_mod",
      "subgroup": [0, 3, 6, 9],
      "n": 12,
      "expected": {
        "group_order": 12,
        "subgroup_order": 4,
        "is_group": true,
        "is_subgroup": true,
        "index": 3,
        "left_cosets": [[0, 3, 6, 9], [1, 4, 7, 10], [2, 5, 8, 11]],
        "partitions_group": true,
        "lagrange_holds": true
      }
    },
    {
      "op": "lagrange_report_add_mod",
      "subgroup": [0, 2, 3],
      "n": 12,
      "expected": {
        "group_order": 12,
        "subgroup_order": 3,
        "is_group": true,
        "is_subgroup": false,
        "index": null,
        "left_cosets": [],
        "partitions_group": false,
        "lagrange_holds": false
      }
    },
    {
      "op": "possible_subgroup_orders_add_mod",
      "n": 12,
      "expected": [1, 2, 3, 4, 6, 12]
    },
    {
      "op": "possible_subgroup_orders_units_mod",
      "n": 8,
      "expected": [1, 2, 4]
    },
    {
      "op": "left_coset_add_mod",
      "representative": 1,
      "subgroup": [0, 2, 3],
      "n": 12,
      "expected_error": "subset must be a subgroup"
    },
    {
      "op": "left_coset_add_mod",
      "representative": 13,
      "subgroup": [0, 3, 6, 9],
      "n": 12,
      "expected_error": "representative must be in the group"
    }
  ]
}
