{
  "source": "Scheme equations from C. Schnorr, \"Efficient Identification and Signatures for Smart Cards\" (1989). Concrete numbers are deterministic regression vectors generated by this lesson's reference implementation using the toy subgroup parameters p=1019, q=509, g=4, SHA-256, and RFC6979-style nonce generation (for reproducibility).",
  "vectors": [
    {
      "op": "mod_inv",
      "a": 3,
      "modulus": 11,
      "expected": 4
    },
    {
      "op": "mod_inv",
      "a": 0,
      "modulus": 11,
      "expected_error": "inverse does not exist"
    },
    {
      "op": "schnorr_public_key",
      "p": 1019,
      "g": 4,
      "x": 123,
      "expected": 504
    },
    {
      "op": "schnorr_sign",
      "message_hex": "68656c6c6f207363686e6f7272",
      "p": 1019,
      "q": 509,
      "g": 4,
      "x": 123,
      "expected": [
        196,
        464
      ]
    },
    {
      "op": "schnorr_verify",
      "message_hex": "68656c6c6f207363686e6f7272",
      "p": 1019,
      "q": 509,
      "g": 4,
      "y": 504,
      "signature": [
        196,
        464
      ],
      "expected": true
    },
    {
      "op": "schnorr_verify",
      "message_hex": "68656c6c6f207363686e6f727221",
      "p": 1019,
      "q": 509,
      "g": 4,
      "y": 504,
      "signature": [
        196,
        464
      ],
      "expected": false
    },
    {
      "op": "schnorr_sign",
      "message_hex": "70617920626f62203130",
      "p": 1019,
      "q": 509,
      "g": 4,
      "x": 123,
      "k": 77,
      "expected": [
        100,
        161
      ]
    },
    {
      "op": "schnorr_sign",
      "message_hex": "706179206d616c6c6f7279203130",
      "p": 1019,
      "q": 509,
      "g": 4,
      "x": 123,
      "k": 77,
      "expected": [
        469,
        247
      ]
    },
    {
      "op": "recover_x_from_nonce_reuse",
      "q": 509,
      "e1": 100,
      "s1": 161,
      "e2": 469,
      "s2": 247,
      "expected": 123
    },
    {
      "op": "recover_x_from_nonce_reuse",
      "q": 509,
      "e1": 1,
      "s1": 2,
      "e2": 1,
      "s2": 3,
      "expected_error": "e1 must differ from e2 (mod q)"
    }
  ]
}
