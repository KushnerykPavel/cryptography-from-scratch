{
  "source": "Toy RSA example (p=61, q=53, e=17) is the classic RSA walkthrough (e.g. Wikipedia 'RSA (cryptosystem)'); SHA-256 values are computed via Python stdlib hashlib (FIPS 180-4 SHA-256). All expected outputs were generated by running this lesson's code deterministically.",
  "vectors": [
    {
      "op": "grover_effective_security_bits",
      "classical_security_bits": 0,
      "expected": 0.0
    },
    {
      "op": "grover_effective_security_bits",
      "classical_security_bits": 128,
      "expected": 64.0
    },
    {
      "op": "grover_required_bits_for_target_security",
      "target_security_bits": 0,
      "expected": 0
    },
    {
      "op": "grover_required_bits_for_target_security",
      "target_security_bits": 128,
      "expected": 256
    },
    {
      "op": "bht_effective_collision_security_bits",
      "hash_output_bits": 256,
      "expected": 85.33333333333333
    },
    {
      "op": "modinv",
      "a": 3,
      "m": 11,
      "expected": 4
    },
    {
      "op": "rsa_keypair_from_primes",
      "p": 61,
      "q": 53,
      "e": 17,
      "expected": {
        "n": 3233,
        "e": 17,
        "d": 2753
      }
    },
    {
      "op": "rsa_encrypt_decrypt_roundtrip",
      "p": 61,
      "q": 53,
      "e": 17,
      "m": 65,
      "expected": {
        "c": 2790,
        "m": 65
      }
    },
    {
      "op": "trial_division_small_factor",
      "n": 15,
      "expected": {
        "factor": 3,
        "steps": 1
      }
    },
    {
      "op": "factor_semiprime_by_trial_division",
      "n": 3233,
      "expected": {
        "p": 53,
        "q": 61,
        "steps": 26
      }
    },
    {
      "op": "break_rsa_by_factoring",
      "n": 3233,
      "e": 17,
      "expected": {
        "p": 53,
        "q": 61,
        "d": 2753
      }
    },
    {
      "op": "sha256_prefix_bits",
      "data_utf8": "0",
      "prefix_bits": 16,
      "expected": 24556
    },
    {
      "op": "sha256_prefix_bits",
      "data_utf8": "1",
      "prefix_bits": 16,
      "expected": 27526
    },
    {
      "op": "find_sha256_prefix_preimage",
      "prefix_bits": 8,
      "target_prefix": 0,
      "max_tries": 5000,
      "expected": {
        "x": 286,
        "queries": 287
      }
    },
    {
      "op": "pqc_replacement_for",
      "primitive": "RSA",
      "expected": "Replace with ML-KEM (Kyber) for KEM; keep RSA only for legacy, behind crypto-agility."
    }
  ]
}
