    },
    {
      "description": "did_document_create returns correct id",
      "op": "did_document_create_id",
      "did": "did:example:issuer",
      "public_key_hex": "0101010101010101010101010101010101010101010101010101010101010101",
      "expected": "did:example:issuer"
    },
    {
      "description": "did_document_create stores pubkey hex",
      "op": "did_document_create_pubkey",
      "did": "did:example:issuer",
      "public_key_hex": "0101010101010101010101010101010101010101010101010101010101010101",
      "expected": "0101010101010101010101010101010101010101010101010101010101010101"
    },
    {
      "description": "vc_sign produces deterministic HMAC-SHA256 proof",
      "op": "vc_sign_proof",
      "vc": {
        "@context": ["https://www.w3.org/2018/credentials/v1"],
        "type": ["VerifiableCredential"],
        "id": "urn:uuid:fixed-0001",
        "issuer": "did:example:issuer",
        "issuanceDate": "2024-01-01T00:00:00Z",
        "credentialSubject": {
          "id": "did:example:holder",
          "name": "Alice",
          "age": 30
        }
      },
      "issuer_sk_hex": "0101010101010101010101010101010101010101010101010101010101010101",
      "expected": "1c4067299d963826b158f2af2945872c2f45ae91dcaeafaa9b4c8f677d3b02a7"
    },
    {
      "description": "vc_verify accepts correct key",
      "op": "vc_verify",
      "vc": {
        "@context": ["https://www.w3.org/2018/credentials/v1"],
        "type": ["VerifiableCredential"],
        "id": "urn:uuid:fixed-0001",
        "issuer": "did:example:issuer",
        "issuanceDate": "2024-01-01T00:00:00Z",
        "credentialSubject": {
          "id": "did:example:holder",
          "name": "Alice",
          "age": 30
        },
        "proof": {
          "type": "Hmac2024",
          "proofValue": "1c4067299d963826b158f2af2945872c2f45ae91dcaeafaa9b4c8f677d3b02a7"
        }
      },
      "pk_hex": "0101010101010101010101010101010101010101010101010101010101010101",
      "expected": true
    },
    {
      "description": "vc_verify rejects wrong key",
      "op": "vc_verify",
      "vc": {
        "@context": ["https://www.w3.org/2018/credentials/v1"],
        "type": ["VerifiableCredential"],
        "id": "urn:uuid:fixed-0001",
        "issuer": "did:example:issuer",
        "issuanceDate": "2024-01-01T00:00:00Z",
        "credentialSubject": {
          "id": "did:example:holder",
          "name": "Alice",
          "age": 30
        },
        "proof": {
          "type": "Hmac2024",
          "proofValue": "1c4067299d963826b158f2af2945872c2f45ae91dcaeafaa9b4c8f677d3b02a7"
        }
      },
      "pk_hex": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "expected": false
    },
    {
      "description": "vp_sign produces deterministic HMAC-SHA256 proof",
      "op": "vp_sign_proof",
      "vp": {
        "@context": ["https://www.w3.org/2018/credentials/v1"],
