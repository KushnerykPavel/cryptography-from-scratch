{
  "source": "hand-computed with ISSUER_SK=0x01*32, HOLDER_SK=0x02*32",
  "vectors": [
    {
      "description": "did_generate basic",
      "op": "did_generate",
      "method": "example",
      "identifier": "issuer",
      "expected": "did:example:issuer"
    },
    {
      "description": "did_generate with did:key method",
      "op": "did_generate",
      "method": "key",
      "identifier": "z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK",
