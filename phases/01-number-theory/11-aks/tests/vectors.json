{
  "source": "Project-internal toy AKS examples cross-checked with Python arithmetic and small trial division.",
  "vectors": [
    {"op": "integer_nth_root", "value": 64, "degree": 3, "expected": 4},
    {"op": "integer_nth_root", "value": 65, "degree": 2, "expected": 8},
    {"op": "integer_nth_root", "value": -1, "degree": 2, "expected_error": "value must be non-negative"},

    {"op": "is_perfect_power", "n": 64, "expected": true},
    {"op": "is_perfect_power", "n": 72, "expected": false},
    {"op": "is_perfect_power", "n": 81, "expected": true},

    {"op": "euler_totient", "n": 9, "expected": 6},
    {"op": "euler_totient", "n": 10, "expected": 4},
    {"op": "euler_totient", "n": 0, "expected_error": "n must be positive"},

    {"op": "multiplicative_order_mod", "n": 2, "r": 5, "expected": 4},
    {"op": "multiplicative_order_mod", "n": 3, "r": 7, "expected": 6},
    {"op": "multiplicative_order_mod", "n": 6, "r": 9, "expected_error": "n and r must be coprime"},

    {"op": "aks_order_threshold", "n": 31, "expected": 25},
    {"op": "find_smallest_r", "n": 31, "expected": 29},
    {"op": "find_smallest_r", "n": 91, "expected": 47},

    {"op": "smallest_factor_up_to", "n": 91, "limit": 20, "expected": 7},
    {"op": "smallest_factor_up_to", "n": 97, "limit": 20, "expected": null},

    {"op": "poly_mul_mod", "left": [1, 1, 0], "right": [1, 2, 0], "modulus": 5, "r": 3, "expected": [1, 3, 2]},
    {"op": "poly_mul_mod", "left": [0, 1, 0], "right": [0, 0, 1], "modulus": 7, "r": 3, "expected": [1, 0, 0]},

    {"op": "poly_pow_mod", "base": [1, 1, 0], "exponent": 5, "modulus": 5, "r": 3, "expected": [1, 0, 1]},
    {"op": "aks_target_polynomial", "n": 5, "r": 3, "a": 2, "expected": [2, 0, 1]},

    {"op": "aks_congruence_holds", "n": 5, "r": 3, "a": 1, "expected": true},
    {"op": "aks_congruence_holds", "n": 9, "r": 5, "a": 1, "expected": false},

    {"op": "aks_witness_limit", "n": 31, "r": 29, "expected": 25},

    {"op": "aks_primality_test", "n": 2, "expected": true},
    {"op": "aks_primality_test", "n": 31, "expected": true},
    {"op": "aks_primality_test", "n": 64, "expected": false},
    {"op": "aks_primality_test", "n": 91, "expected": false},
    {"op": "aks_primality_test", "n": 97, "expected": true},

    {"op": "certificate_route", "n": 1, "expected": "neither-prime-nor-composite"},
    {"op": "certificate_route", "n": 91, "expected": "composite"},
    {"op": "certificate_route", "n": 97, "expected": "prime-by-aks-toy-check"},
    {"op": "certificate_route", "n": 10007, "expected": "prime-use-ecpp-or-library-certification"}
  ]
}
