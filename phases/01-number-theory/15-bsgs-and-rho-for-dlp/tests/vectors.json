{
  "source": "Project-internal educational DLP examples over F_23* and the order-509 quadratic-residue subgroup of F_1019*. Cross-checked by direct modular exponentiation.",
  "vectors": [
    {"op": "ceil_sqrt", "n": 0, "expected": 0},
    {"op": "ceil_sqrt", "n": 22, "expected": 5},
    {"op": "ceil_sqrt", "n": 509, "expected": 23},
    {"op": "ceil_sqrt", "n": -1, "expected_error": "n must be non-negative"},

    {"op": "mod_inverse", "a": 37, "modulus": 509, "expected": 454},
    {"op": "mod_inverse", "a": 6, "modulus": 21, "expected_error": "inverse does not exist"},

    {"op": "solve_linear_congruence", "multiplier": 7, "rhs": 42, "modulus": 509, "expected": [6]},
    {"op": "solve_linear_congruence", "multiplier": 6, "rhs": 12, "modulus": 22, "expected": [2, 13]},
    {"op": "solve_linear_congruence", "multiplier": 6, "rhs": 5, "modulus": 22, "expected_error": "collision cannot be solved"},

    {
      "op": "baby_step_table",
      "p": 23,
      "g": 5,
      "order": 22,
      "expected": {"1": 0, "5": 1, "2": 2, "10": 3, "4": 4}
    },

    {"op": "baby_step_giant_step", "p": 23, "g": 5, "h": 8, "order": 22, "expected": 6},
    {"op": "baby_step_giant_step", "p": 1019, "g": 4, "h": 706, "order": 509, "expected": 37},
    {"op": "baby_step_giant_step", "p": 1019, "g": 4, "h": 504, "order": 509, "expected": 123},
    {"op": "baby_step_giant_step", "p": 1019, "g": 4, "h": 967, "order": 509, "expected": 400},
    {"op": "baby_step_giant_step", "p": 1019, "g": 4, "h": 2, "order": 509, "expected_error": "target is not in the subgroup generated by g"},

    {
      "op": "rho_step",
      "p": 23,
      "g": 5,
      "h": 8,
      "order": 22,
      "state": {"value": 1, "a": 0, "b": 0},
      "expected": {"value": 8, "a": 0, "b": 1}
    },
    {
      "op": "rho_step",
      "p": 23,
      "g": 5,
      "h": 8,
      "order": 22,
      "state": {"value": 5, "a": 1, "b": 0},
      "expected": {"value": 2, "a": 2, "b": 0}
    },
    {
      "op": "rho_step",
      "p": 23,
      "g": 5,
      "h": 8,
      "order": 22,
      "state": {"value": 17, "a": 2, "b": 3},
      "expected": {"value": 13, "a": 4, "b": 6}
    },

    {
      "op": "recover_from_collision",
      "p": 23,
      "g": 5,
      "h": 8,
      "order": 22,
      "left": {"value": 14, "a": 3, "b": 3},
      "right": {"value": 14, "a": 9, "b": 2},
      "expected": 6
    },

    {"op": "pollard_rho_dlp", "p": 23, "g": 5, "h": 8, "order": 22, "expected": [6, 6]},
    {"op": "pollard_rho_dlp", "p": 1019, "g": 4, "h": 706, "order": 509, "expected": [37, 16]},
    {"op": "pollard_rho_dlp", "p": 1019, "g": 4, "h": 504, "order": 509, "expected": [123, 42]},
    {"op": "pollard_rho_dlp", "p": 1019, "g": 4, "h": 967, "order": 509, "expected": [400, 25]},
    {"op": "pollard_rho_dlp", "p": 1019, "g": 4, "h": 504, "order": 509, "max_steps": 1, "retries": 1, "expected_error": "pollard rho failed; retry with a different walk"},

    {"op": "discrete_log", "p": 1019, "g": 4, "h": 504, "order": 509, "method": "bsgs", "expected": 123},
    {"op": "discrete_log", "p": 1019, "g": 4, "h": 504, "order": 509, "method": "rho", "expected": 123},
    {"op": "discrete_log", "p": 1019, "g": 4, "h": 504, "order": 509, "method": "kangaroo", "expected_error": "unknown method"}
  ]
}
