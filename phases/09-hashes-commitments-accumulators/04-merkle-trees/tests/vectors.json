        "left_hex": "876ddc6fadedf88c87a5498b997374c6017fa478af19ecbaf328e93d1820494f",
        "right_hex": "7988c166e32b46f5e9b7c481ffa65f56d4ce0ab7e697382aa8779ac06f076696"
      },
      "expected_hex": "3dc14d8ebcd9e9832129d1163cbeacae4b07bc1ea45ae1da2772763449b59654"
