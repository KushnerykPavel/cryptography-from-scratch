      "expected_hex": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    },
    {
      "op": "encode_leaf_value_hex",
      "inputs": { "value_hex": "747830" },
      "expected_hex": "00000003747830"
    },
    {
      "op": "hash_leaf_hex",
      "inputs": { "value_hex": "747830" },
      "expected_hex": "876ddc6fadedf88c87a5498b997374c6017fa478af19ecbaf328e93d1820494f"
    },
    {
