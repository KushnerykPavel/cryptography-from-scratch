{
  "source": "Regev (2005) defines Learning With Errors (LWE) and a basic public-key encryption construction; Peikert (2016) surveys practical lattice cryptography and LWE variants. These vectors are project-internal deterministic toy instances generated by this lesson's educational implementation using a SHA-256 counter-mode RNG (not constant-time, not production-safe).",
  "vectors": [
    {
      "op": "keygen",
      "seed_hex": "00010203",
      "params": { "n": 4, "m": 8, "q": 97, "error_bound": 1 },
      "expected": {
        "A": [
          [8, 86, 81, 52],
          [82, 42, 95, 66],
          [14, 45, 77, 5],
          [87, 41, 23, 53],
          [60, 18, 19, 58],
          [1, 78, 94, 41],
          [55, 18, 33, 4],
          [10, 0, 90, 17]
        ],
        "b": [88, 12, 91, 77, 82, 65, 8, 35],
        "s": [1, -1, -1, 1]
      }
    },
    {
      "op": "encdec",
      "seed_hex": "00010203",
      "params": { "n": 4, "m": 8, "q": 97, "error_bound": 1 },
      "mu": 0,
      "expected": { "ct": { "u": [57, 49, 27, 65], "v": 54 }, "mu_hat": 0 }
    },
    {
      "op": "encdec",
      "seed_hex": "00010203",
      "params": { "n": 4, "m": 8, "q": 97, "error_bound": 1 },
      "mu": 1,
      "expected": { "ct": { "u": [57, 49, 27, 65], "v": 5 }, "mu_hat": 1 }
    },
    {
      "op": "attack",
      "seed_hex": "00010203",
      "params": { "n": 4, "m": 8, "q": 97, "error_bound": 1 },
      "expected": [1, -1, -1, 1]
    },
    {
      "op": "encdec",
      "seed_hex": "00",
      "params": { "n": 4, "m": 8, "q": 97, "error_bound": 1 },
      "mu": 2,
      "expected_error": "mu must be 0 or 1"
    },
    {
      "op": "keygen",
      "seed_hex": "",
      "params": { "n": 4, "m": 8, "q": 97, "error_bound": 1 },
      "expected_error": "seed must be non-empty"
    },
    {
      "op": "keygen",
      "seed_hex": "00",
      "params": { "n": 0, "m": 8, "q": 97, "error_bound": 1 },
      "expected_error": "n must be positive"
    },
    {
      "op": "keygen",
      "seed_hex": "00",
      "params": { "n": 4, "m": 8, "q": 2, "error_bound": 1 },
      "expected_error": "q must be >= 3"
    },
    {
      "op": "keygen",
      "seed_hex": "00",
      "params": { "n": 4, "m": 8, "q": 97, "error_bound": -1 },
      "expected_error": "error_bound must be non-negative"
    }
  ]
}
