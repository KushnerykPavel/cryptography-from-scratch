{
  "source": "Ring-LWE is introduced by Lyubashevsky, Peikert, and Regev (2010), and Module-LWE is a structured variant used by many efficient KEM/PKE schemes (e.g. Kyber) to trade off structure vs. conservatism. These vectors are project-internal deterministic toy instances generated by this lesson's educational implementation using a SHA-256 counter-mode RNG (not constant-time, not production-safe).",
  "vectors": [
    {
      "op": "rlwe_keygen",
      "seed_hex": "00010203",
      "params": { "n": 8, "q": 97, "error_bound": 1 },
      "expected": {
        "a": [8, 86, 81, 52, 82, 42, 95, 66],
        "b": [51, 69, 32, 66, 32, 96, 3, 8],
        "s": [1, 0, -1, 0, 0, 1, 0, 0]
      }
    },
    {
      "op": "rlwe_encdec",
      "seed_hex": "00010203",
      "params": { "n": 8, "q": 97, "error_bound": 1 },
      "mu": 0,
      "expected": {
        "ct": {
          "u": [91, 52, 76, 32, 32, 58, 89, 48],
          "v": [49, 64, 22, 85, 1, 21, 16, 62]
        },
        "mu_hat": 0
      }
    },
    {
      "op": "rlwe_encdec",
      "seed_hex": "00010203",
      "params": { "n": 8, "q": 97, "error_bound": 1 },
      "mu": 1,
      "expected": {
        "ct": {
          "u": [91, 52, 76, 32, 32, 58, 89, 48],
          "v": [0, 15, 70, 36, 49, 69, 64, 13]
        },
        "mu_hat": 1
      }
    },
    {
      "op": "rlwe_attack",
      "seed_hex": "00010203",
      "params": { "n": 8, "q": 97, "error_bound": 1 },
      "expected": [1, 0, -1, 0, 0, 1, 0, 0]
    },
    {
      "op": "mlwe_keygen",
      "seed_hex": "00010203",
      "params": { "k": 2, "n": 4, "q": 97, "error_bound": 1 },
      "expected": {
        "a": [[8, 86, 81, 52], [82, 42, 95, 66]],
        "b": [23, 25, 19, 62],
        "s": [[1, 0, -1, 0], [0, 1, 0, 0]]
      }
    },
    {
      "op": "mlwe_encdec",
      "seed_hex": "00010203",
      "params": { "k": 2, "n": 4, "q": 97, "error_bound": 1 },
      "mu": 0,
      "expected": {
        "ct": {
          "u": [[70, 41, 79, 25], [19, 57, 24, 10]],
          "v": [40, 84, 67, 10]
        },
        "mu_hat": 0
      }
    },
    {
      "op": "mlwe_encdec",
      "seed_hex": "00010203",
      "params": { "k": 2, "n": 4, "q": 97, "error_bound": 1 },
      "mu": 1,
      "expected": {
        "ct": {
          "u": [[70, 41, 79, 25], [19, 57, 24, 10]],
          "v": [88, 35, 18, 58]
        },
        "mu_hat": 1
      }
    },
    {
      "op": "mlwe_attack",
      "seed_hex": "00010203",
      "params": { "k": 2, "n": 4, "q": 97, "error_bound": 1 },
      "expected": [[1, 0, -1, 0], [0, 1, 0, 0]]
    },
    {
      "op": "rlwe_encdec",
      "seed_hex": "00010203",
      "params": { "n": 8, "q": 97, "error_bound": 1 },
      "mu": 2,
      "expected_error": "mu must be 0 or 1"
    },
    {
      "op": "mlwe_encdec",
      "seed_hex": "00010203",
      "params": { "k": 2, "n": 4, "q": 97, "error_bound": 1 },
      "mu": -1,
      "expected_error": "mu must be 0 or 1"
    },
    {
      "op": "rlwe_keygen",
      "seed_hex": "",
      "params": { "n": 8, "q": 97, "error_bound": 1 },
      "expected_error": "seed must be non-empty"
    },
    {
      "op": "rlwe_keygen",
      "seed_hex": "00",
      "params": { "n": 7, "q": 97, "error_bound": 1 },
      "expected_error": "n must be a power of two"
    },
    {
      "op": "mlwe_keygen",
      "seed_hex": "00",
      "params": { "k": 0, "n": 4, "q": 97, "error_bound": 1 },
      "expected_error": "k must be positive"
    },
    {
      "op": "rlwe_keygen",
      "seed_hex": "00",
      "params": { "n": 8, "q": 2, "error_bound": 1 },
      "expected_error": "q must be >= 3"
    },
    {
      "op": "rlwe_keygen",
      "seed_hex": "00",
      "params": { "n": 8, "q": 97, "error_bound": -1 },
      "expected_error": "error_bound must be non-negative"
    }
  ]
}
