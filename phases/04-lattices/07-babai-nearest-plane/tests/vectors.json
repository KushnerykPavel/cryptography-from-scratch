{
  "source": "Babai (1986), 'On Lovász' lattice reduction and the nearest lattice point problem' (introduces nearest-plane / closest-hyperplane approximation for CVP). Test cases are project-internal deterministic toy instances intended to exercise an exact (Fraction-based) implementation.",
  "vectors": [
    {
      "op": "babai_nearest_plane",
      "basis": [[4, 1], [1, 3]],
      "target": [2, 5],
      "expected": {"coeffs": [0, 2], "vector": [2, 6], "residual": [0, -1], "dist2": 1}
    },
    {
      "op": "babai_nearest_plane",
      "basis": [[1, 5], [6, 21]],
      "target": [10, 10],
      "expected": {"coeffs": [-15, 4], "vector": [9, 9], "residual": [1, 1], "dist2": 2}
    },
    {
      "op": "babai_after_lll",
      "basis": [[1, 5], [6, 21]],
      "target": [10, 10],
      "expected": {
        "reduced_basis": [[2, 1], [-1, 4]],
        "result": {"coeffs": [6, 1], "vector": [11, 10], "residual": [-1, 0], "dist2": 1}
      }
    },
    {
      "op": "babai_vs_cvp",
      "basis": [[7, 1], [1, 1]],
      "target": [6, 2],
      "coeff_bound": 10,
      "expected": {
        "babai": {"coeffs": [1, 1], "vector": [8, 2], "dist2": 4},
        "cvp": {"coeffs": [1, 0], "vector": [7, 1], "dist2": 2}
      }
    },
    {
      "op": "babai_nearest_plane",
      "basis": [[1, 0], [0, 1]],
      "target": [1, 2, 3],
      "expected_error": "target dimension mismatch"
    }
  ]
}
