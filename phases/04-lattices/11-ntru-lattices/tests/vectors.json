{
  "source": "NTRU (Hoffstein–Pipher–Silverman, 1996+) relates small polynomials (f,g) to a public key h ≡ g * f^{-1} (mod q) in R = Z[x]/(x^n-1). The associated public NTRU lattice contains short vectors corresponding to the secret (and its rotations). These vectors are project-internal deterministic toy instances generated by this lesson's educational implementation using a SHA-256 counter-mode RNG (not constant-time, not production-safe).",
  "vectors": [
    {
      "op": "ntru_keygen",
      "seed_hex": "00010203",
      "params": { "n": 7, "q": 29, "f_ones": 2, "f_negs": 1, "g_ones": 2, "g_negs": 2 },
      "expected": {
        "h": [15, 0, 15, 0, 28, 14, 15],
        "f": [0, 0, 0, -1, 1, 0, 1],
        "g": [1, 0, -1, -1, 0, 0, 1]
      }
    },
    {
      "op": "ntru_relation",
      "seed_hex": "00010203",
      "params": { "n": 7, "q": 29, "f_ones": 2, "f_negs": 1, "g_ones": 2, "g_negs": 2 },
      "expected": true
    },
    {
      "op": "ntru_attack_lll",
      "seed_hex": "00010203",
      "params": { "n": 7, "q": 29, "f_ones": 2, "f_negs": 1, "g_ones": 2, "g_negs": 2 },
      "expected": {
        "recovered": { "f": [1, 0, 0, 1, 0, 1, -1], "g": [0, -1, 0, 1, 0, 0, 0] },
        "relation_holds": true,
        "recovered_norm2": 6,
        "original_norm2": 7
      }
    },
    {
      "op": "ntru_keygen",
      "seed_hex": "",
      "params": { "n": 7, "q": 29, "f_ones": 2, "f_negs": 1, "g_ones": 2, "g_negs": 2 },
      "expected_error": "seed must be non-empty"
    },
    {
      "op": "ntru_keygen",
      "seed_hex": "00",
      "params": { "n": 7, "q": 0, "f_ones": 2, "f_negs": 1, "g_ones": 2, "g_negs": 2 },
      "expected_error": "q must be positive"
    },
    {
      "op": "ntru_keygen",
      "seed_hex": "00",
      "params": { "n": 7, "q": 29, "f_ones": 8, "f_negs": 0, "g_ones": 2, "g_negs": 2 },
      "expected_error": "f weight exceeds n"
    },
    {
      "op": "ntru_keygen",
      "seed_hex": "00",
      "params": { "n": 7, "q": 29, "f_ones": 2, "f_negs": 1, "g_ones": 7, "g_negs": 1 },
      "expected_error": "g weight exceeds n"
    }
  ]
}
