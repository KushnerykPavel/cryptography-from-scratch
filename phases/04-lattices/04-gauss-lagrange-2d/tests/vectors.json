{
  "source": "Project-internal 2D Gauss/Lagrange reduction examples (exact integer arithmetic), cross-checked by brute-force SVP enumeration in small coefficient windows.",
  "vectors": [
    {
      "op": "gauss_lagrange_reduce_2d",
      "basis": [[2, 0], [1, 1]],
      "expected": [[1, 1], [1, -1]]
    },
    {
      "op": "gauss_lagrange_reduce_2d",
      "basis": [[1, 5], [6, 21]],
      "expected": [[2, 1], [1, -4]]
    },
    {
      "op": "gauss_lagrange_reduce_2d",
      "basis": [[3, 8], [5, 14]],
      "expected": [[1, 0], [0, 2]]
    },
    {
      "op": "gauss_lagrange_reduce_2d",
      "basis": [[7, 1], [2, 3]],
      "expected": [[2, 3], [5, -2]]
    },
    {
      "op": "is_gauss_reduced_2d",
      "basis": [[2, 1], [1, -4]],
      "expected": true
    },
    {
      "op": "is_gauss_reduced_2d",
      "basis": [[1, 2], [2, 4]],
      "expected": false
    },
    {
      "op": "shortest_vector_gauss_2d",
      "basis": [[2, 0], [1, 1]],
      "expected_norm2": 2
    },
    {
      "op": "shortest_vector_gauss_2d",
      "basis": [[1, 5], [6, 21]],
      "expected_norm2": 5
    },
    {
      "op": "shortest_vector_gauss_2d",
      "basis": [[3, 8], [5, 14]],
      "expected_norm2": 1
    },
    {
      "op": "gauss_lagrange_reduce_2d",
      "basis": [[2, 0], [1, 1]],
      "max_iters": 0,
      "expected_error": "max_iters must be positive"
    },
    {
      "op": "gauss_lagrange_reduce_2d",
      "basis": [[0, 0], [1, 1]],
      "expected_error": "basis must be linearly independent (det != 0)"
    },
    {
      "op": "gauss_lagrange_reduce_2d",
      "basis": [[1, 1], [2, 2]],
      "expected_error": "basis must be linearly independent (det != 0)"
    }
  ]
}
